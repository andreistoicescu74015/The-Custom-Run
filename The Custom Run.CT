          <ID>1300</ID>
          <Description>"AI Tier 6 performance + livery  (auto)"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>{$lua}
getLuaEngine().cbShowOnPrint.Checked=false
getLuaEngine().hide()

function DEC_HEX(IN)
    local B,K,OUT,I,D=16,"0123456789ABCDEF","",0
    while IN&gt;0 do
        I=I+1
        IN,D=math.floor(IN/B),math.mod(IN,B)+1
        OUT=string.sub(K,D,D)..OUT
    end
    return OUT
end

function Split(s, delimiter)
    result = {};
    for match in (s..delimiter):gmatch("(.-)"..delimiter) do
        table.insert(result, match);
    end
    return result;
end

function AOBtoDEC(str)
    split_string = Split(str, " ")
    local hex = ""
    for i=1,#split_string do
        hex = hex .. split_string[#split_string+1-i]
    end
    return(tonumber(hex,16))
end

function hexByteString(addressdec)
    local decByteString = table.concat(readBytes(addressdec,4,true),' ')
    local hexByteS = decByteString:gsub('%S+',function (c) return string.format('%02X',c) end)
    return(hexByteS)
end

local addressStart = "F0000000" --First Vehicle of Customization Template
local addressEnd = "FFFFFFFF" --Last Vehicle of Customization Template

[ENABLE]

-- One AOB scan finds the customization template of the anchor instance
-- (ast_one_77_10_ai_220). Templates are 0x80 bytes each and follow the database
-- order from the Vehicle Customization Library, so every "address + 0xNNN" jump
-- below is a distance in template rows and each block's comment names the row it
-- lands on. PRF_ID is the Tier 6 performance hash written at row+0x60 (donor),
-- LIV_ID the livery hash at row+0x50.

local currentCar = "99 B8 E9 6D" --1844033689 --ast_one_77_10_ai_220

local AOB = "02 00 00 31 56 4F CC 99 "..currentCar.." 56 4F CC 99"
local MyMemscan = createMemScan()
memscan_returnOnlyOneResult(MyMemscan, true)
memscan_firstScan(MyMemscan,soExactValue,vtByteArray,0,AOB,"",addressStart,addressEnd,"*X*W*C",0,"",true,true,false,false)
memscan_waitTillDone(MyMemscan)
local address = memscan_getOnlyResult(MyMemscan) --Returns the address in integer format

-- Baseline. Before writing anything, record the performance hash the game shipped
-- for every row of the template list, keyed by address. The override engine reads
-- this table when an entry is set to Default, so Default restores what the game
-- had rather than what this script wrote. Captured once per session: a second
-- enable must not overwrite the baseline with our own values.
if address ~= nil then
    if TCR_orig == nil then TCR_orig = {} end
    for k = 0, 2268 do
        local a = address + k * 0x80 + 0x60
        if TCR_orig[a] == nil then TCR_orig[a] = readInteger(a) end
    end
end

if address ~= nil then
    local performance = address + 0x60
    local PRF_ID = hexByteString(performance)
    PRF_ID = "2E F3 2B 56"
    writeInteger(performance,AOBtoDEC(PRF_ID))

    address = address + 0x80
    performance = address + 0x60
    writeInteger(performance,AOBtoDEC(PRF_ID))

