--mcl_f1_stk_94_ai_259 (was NOT covered by the walk above)
local f1AOB = "02 00 00 31 56 4F CC 99 22 1D BD 8E 56 4F CC 99"
local f1scan = createMemScan()
memscan_returnOnlyOneResult(f1scan, true)
memscan_firstScan(f1scan,soExactValue,vtByteArray,0,f1AOB,"",addressStart,addressEnd,"*X*W*C",0,"",true,true,false,false)
memscan_waitTillDone(f1scan)
local f1addr = memscan_getOnlyResult(f1scan)
if f1addr ~= nil then
    -- ai_259 is the only AI McLaren F1 template. The next three rows are the
    -- player's Stock 1-3 skins, so write exactly one record.
    writeInteger(f1addr + 0x60, AOBtoDEC("7A 5A E0 DB"))
end

