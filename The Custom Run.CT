    <CheatEntry>
      <ID>9312</ID>
      <Description>"Night controller  (auto)"</Description>
      <Options moHideChildren="1" />
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{$lua}
getLuaEngine().cbShowOnPrint.Checked=false
getLuaEngine().hide()
[ENABLE]
inj = getAddressList().getMemoryRecordByID(9000)
lastNight = nil
function NightVisEnv()
  if getAddressSafe("timeofday") == nil then return end
  if inj == nil then return end
  if readPointer("[timeofday]") == nil then return end
  local guid = readInteger(getAddress("[timeofday]") - 0x68)
  if guid == nil then return end
  local tod, want
  if guid == 2702358496 then
    tod = 0; want = true
  elseif guid == 2494877324 then
    tod = 3; want = true
  else
    tod = 4; want = false
    if getAddressSafe("sequenceHook") ~= nil then
      local sp = readInteger("[sequenceHook]")
      if sp ~= nil and sp ~= 0 and readInteger(sp + 0x2B) == 1095981390 then want = true end
    end
  end
  writeInteger("[timeofday]", tod)
  if want ~= lastNight then
    if want then memoryrecord_freeze(inj) else memoryrecord_unfreeze(inj) end
    lastNight = want
  end
end
if nvsTimer == nil then nvsTimer = createTimer(nil) end
timer_onTimer(nvsTimer, NightVisEnv)
timer_setInterval(nvsTimer, 1)
timer_setEnabled(nvsTimer, true)
[DISABLE]
if nvsTimer ~= nil then
  timer_setEnabled(nvsTimer, false)
end
if inj ~= nil then memoryrecord_unfreeze(inj) end
lastNight = nil
</AssemblerScript>
