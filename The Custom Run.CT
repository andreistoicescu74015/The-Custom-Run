      <Description>"CURRENT CAR (showroom)   --  step 1, open View Cars to read the Model and Skin"</Description>
      <Options moActivateChildrenAsWell="1" moDeactivateChildrenAsWell="1" moManualExpandCollapse="1" />
      <GroupHeader>1</GroupHeader>
      <CheatEntries>
        <CheatEntry>
          <ID>9901</ID>
          <Description>"Showroom engine  (auto)"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>{$lua}
getLuaEngine().cbShowOnPrint.Checked=false
getLuaEngine().hide()
[ENABLE]
local skins = {["alf_8c_com_09"]={{28692514,"NFS Edition"}},["ast_one_77_10"]={{2723042599,"Rival 1"}},["ast_van_v12_10"]={{1416749643,"Rare 1"}},["aud_r8_v10_10"]={{1078212109,"Run"}},["bug_vey_ss_10"]={{1396925995,"Stock 1"},{233386615,"Stock 2"},{198885591,"Stock 3"},{2508479814,"Stock 4"},{38889236,"Stock 5"},{2998207530,"Stock 6"},{222257381,"Stock 7"},{3456734173,"Stock 8"},{397414533,"Style Pack 1 - 1"},{13600042,"Style Pack 1 - 2"},{1173801304,"Style Pack 1 - 3"},{2683073109,"Style Pack 1 - 4"},{3414920866,"Style Pack 1 - 5"},{4061025962,"Style Pack 1 - 6"},{4269471868,"Style Pack 1 - 7"},{1201919218,"Style Pack 1 - 8"}},["che_vet_cbn_10"]={{1289781367,"Rare 1"},{1732803059,"NFS Edition"}},["dod_cha_srt_08"]={{678390126,"Adsales 1"}},["she_mus_snk_12"]={{540039182,"Rare 1"}},["hen_ven_gt_11"]={{1889692556,"Stock 1"},{2875939421,"Stock 2"},{1843403582,"Stock 3"},{1559471646,"Stock 4"},{1293973268,"Stock 5"},{1435683144,"Stock 6"},{2573564796,"Stock 7"},{2334641747,"Stock 8"},{1532349533,"Style Pack 1 - 1"},{1612734426,"Style Pack 1 - 2"},{1350165957,"Style Pack 1 - 3"},{3838522613,"Style Pack 1 - 4"},{3126269201,"Style Pack 1 - 5"},{2902535361,"Style Pack 1 - 6"},{42442522,"Style Pack 1 - 7"},{284782573,"Style Pack 1 - 8"}},["koe_age_r_11"]={{938384918,"Stock 1"},{3882992039,"Stock 2"},{1371105745,"Stock 3"},{2626688083,"Stock 4"},{1231578851,"Stock 5"},{3884005823,"Stock 6"},{789750505,"Stock 7"},{4215073769,"Stock 8"},{450562262,"Style Pack 1 - 1"},{3174728285,"Style Pack 1 - 2"},{3125779387,"Style Pack 1 - 3"},{3260662067,"Style Pack 1 - 4"},{132303528,"Style Pack 1 - 5"},{3392822886,"Style Pack 1 - 6"},{4175699004,"Style Pack 1 - 7"},{1147481775,"Style Pack 1 - 8"}},["lam_ave_700_12"]={{2196261666,"Run"}},["lam_dia_sv_95"]={{2661219538,"NFS Edition"}},["lam_mur_sv_10"]={{2854099895,"Rare 1"}},["lam_ses_ele_11"]={{1021146513,"Rare 1"}},["mas_gt_str_12"]={{2233010987,"NFS Edition"}},["mas_mc_str_05"]={{877856617,"Stock 1"}},["maz_rx7_rz_98"]={{529645684,"NFS Edition"}},["mcl_f1_stk_94"]={{3082609147,"Stock 1"},{1842326981,"Stock 2"},{3597153073,"Stock 3"},{2027198581,"Stock 4"},{4061750909,"Stock 5"},{3284152259,"Stock 6"},{3971845986,"Stock 7"},{2188451802,"Stock 8"},{2188732611,"Style Pack 1 - 1"},{8847892,"Style Pack 1 - 2"},{2546659436,"Style Pack 1 - 3"},{4201908254,"Style Pack 1 - 4"},{3309128826,"Style Pack 1 - 5"},{3763200407,"Style Pack 1 - 6"},{734242523,"Style Pack 1 - 7"},{4147231431,"Style Pack 1 - 8"},{3451952857,"Aero Pack - 1"},{2727696005,"Aero Pack - 2"},{2569286113,"Aero Pack - 3"},{179413785,"Aero Pack - 4"},{2797745784,"Aero Pack - 5"},{4269482447,"Aero Pack - 6"},{1346627002,"Aero Pack - 7"},{3904972435,"Aero Pack - 8"}},["mcl_mp4_12c_12"]={{3784919988,"NFS Edition"}},["mit_evo_x_08"]={{541096327,"Rare 1"}},["nis_240_zg_71"]={{4150176875,"Rare 1"}},["nis_gtr_stk_73"]={{1203603962,"Rare 1"}},["nis_gtr_v_10"]={{501327745,"Run"}},["nis_gtr_r32_91"]={{1279882972,"Rare 1"}},["pag_hua_stk_11"]={{671513072,"Run"},{2149624056,"Rare 1"}},["pag_zon_cin_10"]={{1785461374,"Rare 1"}},["pag_zon_r_09"]={{1606620635,"Stock 1"},{1129839707,"Stock 2"},{4142030595,"Stock 3"},{2209869415,"Stock 4"},{3410933518,"Stock 5"},{2013786111,"Stock 6"}},["por_993_gt2_96"]={{1591107591,"Adsales 1"}},["por_918_rsr_11"]={{2235038457,"Rare 1"},{893260034,"Run"}}}
local carname = {["alf_8c_com_09"]="Alfa Romeo 8C Competizione",["ast_one_77_10"]="Aston Martin One-77",["ast_van_v12_10"]="Aston Martin V12 Vantage",["aud_r8_v10_10"]="Audi R8 V10",["bug_vey_ss_10"]="Bugatti Veyron 16.4 Super Sport",["che_vet_cbn_10"]="Chevrolet Corvette Z06 Carbon LE",["dod_cha_srt_08"]="Dodge Challenger R/T",["she_mus_snk_12"]="Ford Shelby GT500 Super Snake",["hen_ven_gt_11"]="Hennessey Venom GT",["koe_age_r_11"]="Koenigsegg Agera R",["lam_ave_700_12"]="Lamborghini Aventador LP 700-4",["lam_dia_sv_95"]="Lamborghini Diablo SV",["lam_mur_sv_10"]="Lamborghini Murcielago LP 670-4 SV",["lam_ses_ele_11"]="Lamborghini Sesto Elemento",["mas_gt_str_12"]="Maserati GranTurismo MC Stradale",["mas_mc_str_05"]="Maserati MC12",["maz_rx7_rz_98"]="Mazda RX-7 RZ",["mcl_f1_stk_94"]="McLaren F1",["mcl_mp4_12c_12"]="McLaren MP4-12C",["mit_evo_x_08"]="Mitsubishi Lancer Evolution X",["nis_240_zg_71"]="Nissan Fairlady 240ZG",["nis_gtr_stk_73"]="Nissan Skyline 2000GT-R",["nis_gtr_v_10"]="Nissan GT-R SpecV",["nis_gtr_r32_91"]="Nissan Skyline GT-R (R32)",["pag_hua_stk_11"]="Pagani Huayra",["pag_zon_cin_10"]="Pagani Zonda Cinque",["pag_zon_r_09"]="Pagani Zonda R",["por_993_gt2_96"]="Porsche 911 GT2",["por_918_rsr_11"]="Porsche 918 RSR"}
local rev = {}
for cc,L in pairs(skins) do for k=1,#L do rev[L[k][1]] = {cc, L[k][2]} end end
local function ident(h)
  if h == nil then return "-" end
  if h == 0 then return "0 (empty)" end
  local e = rev[h]
  if e ~= nil and carname[e[1]] ~= nil then return carname[e[1]].." - "..e[2] end
  return string.format("?? raw %X", h)
end
local mr = getAddressList().getMemoryRecordByID(9910)
local last = -1
local function tick()
  local ok,err = pcall(function()
    if mr == nil then return end
    local h = readInteger(0xFFC54DBC, false)
    if h == nil or h == last then return end
    last = h
    mr.DropDownList.clear()
    mr.DropDownList.add(string.format("%X", h)..":"..ident(h))
  end)
  if not ok then print("[showroom] "..tostring(err)) end
end
if showroomTimer ~= nil then timer_setEnabled(showroomTimer,false) end
showroomTimer = createTimer(nil)
timer_onTimer(showroomTimer, tick)
timer_setInterval(showroomTimer, 500)
timer_setEnabled(showroomTimer, true)
[DISABLE]
if showroomTimer ~= nil then timer_setEnabled(showroomTimer,false); showroomTimer=nil end</AssemblerScript>
          <CheatEntries>
            <CheatEntry>
              <ID>9910</ID>
              <Description>"Current Car   (Model - Skin)"</Description>
              <ShowAsHex>1</ShowAsHex>
              <VariableType>4 Bytes</VariableType>
              <Address>FFC54DBC</Address>
              <DropDownList DescriptionOnly="1" DisplayValueAsItem="1" ReadOnly="1" />
            </CheatEntry>
          </CheatEntries>
        </CheatEntry>
      </CheatEntries>
    </CheatEntry>
    <CheatEntry>
      <ID>9700</ID>
      <Description>"CURRENT CAR SKIN   --  step 2, pick a variant for that car, applies on restart"</Description>
      <Options moActivateChildrenAsWell="1" moDeactivateChildrenAsWell="1" moManualExpandCollapse="1" />
      <GroupHeader>1</GroupHeader>
      <CheatEntries>
        <CheatEntry>
          <ID>9701</ID>
          <Description>"Skin engine  (auto)"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>{$lua}
getLuaEngine().cbShowOnPrint.Checked=false
getLuaEngine().hide()
[ENABLE]
local skins = {["alf_8c_com_09"]={{28692514,"NFS Edition"}},["ast_one_77_10"]={{2723042599,"Rival 1"}},["ast_van_v12_10"]={{1416749643,"Rare 1"}},["aud_r8_v10_10"]={{1078212109,"Run"}},["bug_vey_ss_10"]={{1396925995,"Stock 1"},{233386615,"Stock 2"},{198885591,"Stock 3"},{2508479814,"Stock 4"},{38889236,"Stock 5"},{2998207530,"Stock 6"},{222257381,"Stock 7"},{3456734173,"Stock 8"},{397414533,"Style Pack 1 - 1"},{13600042,"Style Pack 1 - 2"},{1173801304,"Style Pack 1 - 3"},{2683073109,"Style Pack 1 - 4"},{3414920866,"Style Pack 1 - 5"},{4061025962,"Style Pack 1 - 6"},{4269471868,"Style Pack 1 - 7"},{1201919218,"Style Pack 1 - 8"}},["che_vet_cbn_10"]={{1289781367,"Rare 1"},{1732803059,"NFS Edition"}},["dod_cha_srt_08"]={{678390126,"Adsales 1"}},["she_mus_snk_12"]={{540039182,"Rare 1"}},["hen_ven_gt_11"]={{1889692556,"Stock 1"},{2875939421,"Stock 2"},{1843403582,"Stock 3"},{1559471646,"Stock 4"},{1293973268,"Stock 5"},{1435683144,"Stock 6"},{2573564796,"Stock 7"},{2334641747,"Stock 8"},{1532349533,"Style Pack 1 - 1"},{1612734426,"Style Pack 1 - 2"},{1350165957,"Style Pack 1 - 3"},{3838522613,"Style Pack 1 - 4"},{3126269201,"Style Pack 1 - 5"},{2902535361,"Style Pack 1 - 6"},{42442522,"Style Pack 1 - 7"},{284782573,"Style Pack 1 - 8"}},["koe_age_r_11"]={{938384918,"Stock 1"},{3882992039,"Stock 2"},{1371105745,"Stock 3"},{2626688083,"Stock 4"},{1231578851,"Stock 5"},{3884005823,"Stock 6"},{789750505,"Stock 7"},{4215073769,"Stock 8"},{450562262,"Style Pack 1 - 1"},{3174728285,"Style Pack 1 - 2"},{3125779387,"Style Pack 1 - 3"},{3260662067,"Style Pack 1 - 4"},{132303528,"Style Pack 1 - 5"},{3392822886,"Style Pack 1 - 6"},{4175699004,"Style Pack 1 - 7"},{1147481775,"Style Pack 1 - 8"}},["lam_ave_700_12"]={{2196261666,"Run"}},["lam_dia_sv_95"]={{2661219538,"NFS Edition"}},["lam_mur_sv_10"]={{2854099895,"Rare 1"}},["lam_ses_ele_11"]={{1021146513,"Rare 1"}},["mas_gt_str_12"]={{2233010987,"NFS Edition"}},["mas_mc_str_05"]={{877856617,"Stock 1"}},["maz_rx7_rz_98"]={{529645684,"NFS Edition"}},["mcl_f1_stk_94"]={{3082609147,"Stock 1"},{1842326981,"Stock 2"},{3597153073,"Stock 3"},{2027198581,"Stock 4"},{4061750909,"Stock 5"},{3284152259,"Stock 6"},{3971845986,"Stock 7"},{2188451802,"Stock 8"},{2188732611,"Style Pack 1 - 1"},{8847892,"Style Pack 1 - 2"},{2546659436,"Style Pack 1 - 3"},{4201908254,"Style Pack 1 - 4"},{3309128826,"Style Pack 1 - 5"},{3763200407,"Style Pack 1 - 6"},{734242523,"Style Pack 1 - 7"},{4147231431,"Style Pack 1 - 8"},{3451952857,"Aero Pack - 1"},{2727696005,"Aero Pack - 2"},{2569286113,"Aero Pack - 3"},{179413785,"Aero Pack - 4"},{2797745784,"Aero Pack - 5"},{4269482447,"Aero Pack - 6"},{1346627002,"Aero Pack - 7"},{3904972435,"Aero Pack - 8"}},["mcl_mp4_12c_12"]={{3784919988,"NFS Edition"}},["mit_evo_x_08"]={{541096327,"Rare 1"}},["nis_240_zg_71"]={{4150176875,"Rare 1"}},["nis_gtr_stk_73"]={{1203603962,"Rare 1"}},["nis_gtr_v_10"]={{501327745,"Run"}},["nis_gtr_r32_91"]={{1279882972,"Rare 1"}},["pag_hua_stk_11"]={{671513072,"Run"},{2149624056,"Rare 1"}},["pag_zon_cin_10"]={{1785461374,"Rare 1"}},["pag_zon_r_09"]={{1606620635,"Stock 1"},{1129839707,"Stock 2"},{4142030595,"Stock 3"},{2209869415,"Stock 4"},{3410933518,"Stock 5"},{2013786111,"Stock 6"}},["por_993_gt2_96"]={{1591107591,"Adsales 1"}},["por_918_rsr_11"]={{2235038457,"Rare 1"},{893260034,"Run"}}}
local carname = {["alf_8c_com_09"]="Alfa Romeo 8C Competizione",["ast_one_77_10"]="Aston Martin One-77",["ast_van_v12_10"]="Aston Martin V12 Vantage",["aud_r8_v10_10"]="Audi R8 V10",["bug_vey_ss_10"]="Bugatti Veyron 16.4 Super Sport",["che_vet_cbn_10"]="Chevrolet Corvette Z06 Carbon LE",["dod_cha_srt_08"]="Dodge Challenger R/T",["she_mus_snk_12"]="Ford Shelby GT500 Super Snake",["hen_ven_gt_11"]="Hennessey Venom GT",["koe_age_r_11"]="Koenigsegg Agera R",["lam_ave_700_12"]="Lamborghini Aventador LP 700-4",["lam_dia_sv_95"]="Lamborghini Diablo SV",["lam_mur_sv_10"]="Lamborghini Murcielago LP 670-4 SV",["lam_ses_ele_11"]="Lamborghini Sesto Elemento",["mas_gt_str_12"]="Maserati GranTurismo MC Stradale",["mas_mc_str_05"]="Maserati MC12",["maz_rx7_rz_98"]="Mazda RX-7 RZ",["mcl_f1_stk_94"]="McLaren F1",["mcl_mp4_12c_12"]="McLaren MP4-12C",["mit_evo_x_08"]="Mitsubishi Lancer Evolution X",["nis_240_zg_71"]="Nissan Fairlady 240ZG",["nis_gtr_stk_73"]="Nissan Skyline 2000GT-R",["nis_gtr_v_10"]="Nissan GT-R SpecV",["nis_gtr_r32_91"]="Nissan Skyline GT-R (R32)",["pag_hua_stk_11"]="Pagani Huayra",["pag_zon_cin_10"]="Pagani Zonda Cinque",["pag_zon_r_09"]="Pagani Zonda R",["por_993_gt2_96"]="Porsche 911 GT2",["por_918_rsr_11"]="Porsche 918 RSR"}
local rev = {}
for cc,L in pairs(skins) do for k=1,#L do rev[L[k][1]] = cc end end
local lastHash = -1
local mr = getAddressList().getMemoryRecordByDescription("Current Car Skin")
local function tick()
  local ok,err = pcall(function()
    if mr == nil then return end
    local base = getAddress("Need For Speed The Run.exe+023B8D58")
    if base == nil then return end
    local p = readInteger(base, false)
    if p == nil or p == 0 then return end
    local h = readInteger(p + 0x3C8, false)
    if h == nil then return end
    if h == lastHash then return end
    lastHash = h
    local cc = rev[h]
    mr.DropDownList.clear()
    if cc ~= nil and skins[cc] ~= nil then
      local L = skins[cc]
      for k=1,#L do mr.DropDownList.add(string.format("%X", L[k][1])..":"..carname[cc].." - "..L[k][2]) end
    end
  end)
  if not ok then print("[cur-skin] "..tostring(err)) end
end
if curSkinTimer ~= nil then timer_setEnabled(curSkinTimer,false) end
curSkinTimer = createTimer(nil)
timer_onTimer(curSkinTimer, tick)
timer_setInterval(curSkinTimer, 700)
timer_setEnabled(curSkinTimer, true)
[DISABLE]
if curSkinTimer ~= nil then timer_setEnabled(curSkinTimer,false); curSkinTimer=nil end</AssemblerScript>
