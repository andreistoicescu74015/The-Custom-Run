if getAddressSafe("ai_perf") == nil then
  autoAssemble([[
alloc(ai_perf,$120)
registersymbol(ai_perf)
]])
  local a=getAddressSafe("ai_perf")
  if a~=nil then for i=1,69 do writeInteger(a+(i-1)*4, carTbl[i][4]) end writeInteger(a+0x114, 0) end
end
local cache={}; local lastSel={}; local orig={}; local ro=nil
local function aobdec(s) local h=""; for b in s:gmatch("%S+") do h=b..h end; return tonumber(h,16) end
local function scanFor(hx)
  local aob="02 00 00 31 56 4F CC 99 "..hx.." 56 4F CC 99"
  local s=createMemScan(); memscan_returnOnlyOneResult(s,true)
  memscan_firstScan(s,soExactValue,vtByteArray,0,aob,"","F0000000","FFFFFFFF","*X*W*C",0,"",true,true,false,false)
  memscan_waitTillDone(s); return memscan_getOnlyResult(s)
end
local function aiTick()
  local ok,err=pcall(function()
    local pb=getAddressSafe("ai_perf"); if pb==nil then return end
    for i=1,69 do
      local sel=readInteger(pb+(i-1)*4); local c=carTbl[i]; local di=c[4]
      if sel~=lastSel[i] then lastSel[i]=sel; if cache[i]==0 then cache[i]=nil end end
      if sel~=di or cache[i]~=nil then
        if cache[i]==nil then cache[i]=scanFor(c[1]) or 0 end
        if cache[i]~=0 then
          if orig[i]==nil then
            orig[i]={}
            for n=0,c[2]-1 do
              local a=cache[i]+n*0x80+0x60
              local v=nil; if TCR_orig~=nil then v=TCR_orig[a] end
              if v==nil then v=readInteger(a) end
              orig[i][n]=v
            end
          end
          local prf; if sel==0 then prf="" elseif sel==di then prf=c[3] else prf=donor[sel] end
          if prf=="" then
            for n=0,c[2]-1 do writeInteger(cache[i]+n*0x80+0x60, orig[i][n]) end
          elseif prf~=nil then
            for n=0,c[2]-1 do writeInteger(cache[i]+n*0x80+0x60, aobdec(prf)) end
          end
        end
      end
    end
    if ro==nil then ro=getAddressList().getMemoryRecordByID(97000) end
    if ro~=nil then
      ro.DropDownList.clear(); local lines={}
      for i=1,69 do
        local sel=readInteger(pb+(i-1)*4)
        if sel~=carTbl[i][4] then
          local st="scanning"; if cache[i]==0 then st="NOT FOUND" elseif cache[i]~=nil then st="OK" end
          local dn; if sel==0 then dn="Default  (game original)" else dn=donorNames[sel] end
          if dn==nil then dn="donor "..sel end
          lines[#lines+1]=carNames[i].."  -&gt;  "..dn.."   ["..st.."]"
        end
      end
      ro.DropDownList.add("0:"..#lines.." changed, expand to read them")
      for k=1,#lines do ro.DropDownList.add(k..":"..lines[k]) end
    end
  end)
  if not ok then print("[ai-perf] "..tostring(err)) end
end
aiPerfTimer=createTimer(nil); timer_onTimer(aiPerfTimer, aiTick)
timer_setInterval(aiPerfTimer, 1000); timer_setEnabled(aiPerfTimer, true)
[DISABLE]
if aiPerfTimer ~= nil then timer_setEnabled(aiPerfTimer,false); aiPerfTimer=nil end
if getAddressSafe("ai_perf") ~= nil then
  autoAssemble([[
unregistersymbol(ai_perf)
dealloc(ai_perf)
]])
end</AssemblerScript>
        </CheatEntry>
        <CheatEntry>
          <ID>1417</ID>
          <Description>"Text Swap (en)  (auto)"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
aobscanmodule(text_change,Need For Speed The Run.exe,89 94 24 8C 09 00 00)
registersymbol(checkvar)
alloc(checkvar,8)
alloc(carClassText,$20)
alloc(newmem,$200)
label(code)
label(return)

checkvar:
  dd 0
  dd 0

registersymbol(checkvar)

carClassText:
  dd 00360054 //T6
  dd 00410020 // A
  dd 00640075 //ud
  dd 002C0069 //i,
  dd 004E0020 // N
  dd 00730069 //is
  dd 00610073 //sa
  dd 0000006E //n

registersymbol(carClassText)

newmem:
  push eax
  mov ebx,[ebx]
  cmp [ebx+C],00450053 //STAGE [SE]LECT
  je title_check

performance_check:
  cmp [ebx+E],00650050 //Tier 4 [Pe]rformance
  je story_car_select
  cmp [checkvar+4],1
  jne car_swap_check

tier_check:
  cmp cx,DDD4 //compare needed widget
  jne car_swap_check
  cmp [ebx+2C],00610043 //Car Class: Any Tier 4 [Ca]r
  je swap_level2
  cmp [ebx+2C],00750041 //Car Class: Any Tier 4 [Au]di
  je swap_audi

car_swap_check:
  cmp [ebx+16],00610043 //Any Tier 4 [Ca]r
  je swap_level
  cmp [ebx+16],00750041 //Any Tier 4 [Au]di
  je swap_level_audi

code:
  pop eax
  mov ebx,[esp]
  mov [esp+0000098C],edx
  jmp return

swap_level:
  mov [ebx+10],00360020
  mov [checkvar],eax
  jmp code

swap_level2:
  mov [ebx+26],00360020
  jmp code

swap_level_audi:
  mov [checkvar],eax
  push ecx
  push edx
  mov ecx,8 //num of iterations
  mov edx,0 //index

mov_text:
  mov eax,[carClassText+edx*4]
  mov [ebx+edx*4],eax
  inc dl
  loop mov_text
  pop edx
  pop ecx
  jmp code

swap_audi:
  push ecx
  push edx
  mov ecx,8
  mov edx,0
  add ebx,16 //offset to needed char position
  jmp mov_text

story_car_select:
  mov [ebx+A],00200036
  jmp code

title_check:
  cmp [ebx+8],00200045 //STAG[E ]SELECT
  jne performance_check
  cmp cx,DA30 //compare needed widget
  je mov_var_2
  cmp cx,DB54 //compare needed widget
  je mov_var_2
  dec [checkvar+4]
  jmp car_swap_check

mov_var_2:
  mov [checkvar+4],2
  jmp tier_check

text_change:
  jmp newmem
  nop 2
return:
registersymbol(text_change)

[DISABLE]

text_change:
  db 89 94 24 8C 09 00 00

unregistersymbol(text_change)
dealloc(newmem)
</AssemblerScript>
        </CheatEntry>
