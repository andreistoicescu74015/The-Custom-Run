        <CheatEntry>
          <ID>1385</ID>
          <Description>"Gas station toggles engine  (auto)"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>{$lua}
getLuaEngine().cbShowOnPrint.Checked=false
getLuaEngine().hide()
[ENABLE]
if gasToggleTimer ~= nil then timer_setEnabled(gasToggleTimer,false); gasToggleTimer=nil end
if getAddressSafe("gas_show") == nil then
  autoAssemble([[
alloc(gas_show,$58)
registersymbol(gas_show)
]])
  local sb0 = getAddressSafe("gas_show")
  if sb0 ~= nil then
    for i=0,21 do writeInteger(sb0 + i*4, 1) end
  end
end
if getAddressSafe("gas_mode") == nil then
  autoAssemble([[
alloc(gas_mode,4)
registersymbol(gas_mode)
]])
  local mb0 = getAddressSafe("gas_mode")
  if mb0 ~= nil then writeInteger(mb0, 1) end
end
local master = {0xA24E5527,0x4044360D,0x5343662B,0x4CE08077,0x674879F3,0x70A26B8C,0x37EE9E16,0x82E84B22,0xAA1E1BB7,0x3CDD7591,0x1F91C074,0xB7BCE1FB,0xE1994BB4,0xF75EAC6B,0x4C4976DC,0x47BD89FA,0x1DE1A781,0x280679F0,0x8020A8F8,0x6A6BFA7E,0x8537FAF9,0x353E1102}
local garages = {{"junkyard_car",1},{"sf_cars",5},{"lv_cars",3},{"chi_cars",3},{"uri_cars",3}}
-- Every skin and body kit of the four cars that have kits, one row per car. Two
-- things need this. Recognising the car you are driving as belonging to a garage
-- slot, which fails otherwise when you leave the garage on a kit, because the
-- current car reads back as the kit hash and the slot still holds the skin you
-- picked. And mapping any of them to the car's base model below.
local variantGroups = {
  {1396925995,233386615,198885591,2508479814,38889236,2998207530,222257381,3456734173,397414533,13600042,1173801304,2683073109,3414920866,4061025962,4269471868,1201919218},
  {1889692556,2875939421,1843403582,1559471646,1293973268,1435683144,2573564796,2334641747,1532349533,1612734426,1350165957,3838522613,3126269201,2902535361,42442522,284782573},
  {938384918,3882992039,1371105745,2626688083,1231578851,3884005823,789750505,4215073769,450562262,3174728285,3125779387,3260662067,132303528,3392822886,4175699004,1147481775},
  {3082609147,1842326981,3597153073,2027198581,4061750909,3284152259,3971845986,2188451802,2188732611,8847892,2546659436,4201908254,3309128826,3763200407,734242523,4147231431,3451952857,2727696005,2569286113,179413785,2797745784,4269482447,1346627002,3904972435}
}
-- Do not put a car's base model row in here. Handing the gas station
-- bug_vey_ss_10 rather than one of its variants crashes the game. Only the
-- variants are loadable as cars.
local function groupOf(h)
  for i,G in ipairs(variantGroups) do
    for _,x in ipairs(G) do if x == h then return i end end
  end
  return nil
end
local function sameCar(a,b)
  if a == b then return true end
  local i = groupOf(a)
  if i ~= nil then for _,x in ipairs(variantGroups[i]) do if x == b then return true end end end
  return false
end
-- Any variant maps to the first skin of its group. Dropping this so the gas
-- station offered the slot's exact hash broke colour selection on the Venom and
-- the Agera, so it stays. The cost is the one noted yesterday: a kit in a garage
-- slot is offered at the gas station as that car's Stock 1, kit included in the
-- car but not in the offer.
local function baseOf(h)
  local i = groupOf(h)
  if i ~= nil then return variantGroups[i][1] end
  return h
end

local function currentGarageSet()
  local cur = nil
  pcall(function()
    local p = readInteger(getAddress("Need For Speed The Run.exe+023B8D58"), false)
    if p ~= nil and p ~= 0 then cur = readInteger(p + 0x3C8, false) end
  end)
  if cur == nil or cur == 0 then return nil end
  for _,g in ipairs(garages) do
    local base = getAddressSafe(g[1])
    if base ~= nil then
      for i=0,g[2]-1 do
        if sameCar(readInteger(base + i*4, false), cur) then
          local set = {}
          for j=0,g[2]-1 do set[#set+1] = baseOf(readInteger(base + j*4, false)) end
          return set
        end
      end
    end
  end
  return nil
end
local function gasTick()
  local ok,err = pcall(function()
    local sb = getAddressSafe("gas_show")
    local cb = getAddressSafe("carArray")
    local mb = getAddressSafe("gas_mode")
    if sb == nil or cb == nil then return end
    local enabled
    if mb ~= nil and readInteger(mb) == 1 then enabled = currentGarageSet() end
    if enabled == nil then
      enabled = {}
      for i=0,21 do
        if readInteger(sb + i*4) ~= 0 then enabled[#enabled+1] = master[i+1] end
      end
    end
    if #enabled == 0 then enabled = { master[1] } end
    for i=0,31 do
      writeInteger(cb + i*4, enabled[(i % #enabled) + 1])
    end
  end)
  if not ok then print("[gas] "..tostring(err)) end
end
gasToggleTimer = createTimer(nil)
timer_onTimer(gasToggleTimer, gasTick)
timer_setInterval(gasToggleTimer, 500)
timer_setEnabled(gasToggleTimer, true)
[DISABLE]
if gasToggleTimer ~= nil then timer_setEnabled(gasToggleTimer,false); gasToggleTimer=nil end
if getAddressSafe("gas_show") ~= nil then
  autoAssemble([[
unregistersymbol(gas_show)
dealloc(gas_show)
]])
end
if getAddressSafe("gas_mode") ~= nil then
  autoAssemble([[
unregistersymbol(gas_mode)
dealloc(gas_mode)
]])
end</AssemblerScript>
