                writeInteger(lastCarClassID + 0xC,  readInteger(s+0x4))
                writeInteger(lastCarClassID + 0x14, readInteger(s+0x8))
                writeInteger(lastCarClassID + 0x1C, readInteger(s+0xC))
                writeInteger(lastCarClassID + 0x24, readInteger(s+0x10))
